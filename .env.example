# Base de datos (async driver)
DATABASE_URL=postgresql+asyncpg://nomiapp:nomiapp@localhost:5433/nomiapp

# Seguridad / JWT
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (separar por comas)
CORS_ORIGINS=["http://localhost:5173"]

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=nomiapp-storage

# Resend (envío de emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Anthropic
ANTHROPIC_API_KEY=  # Dejar vacío hasta configurar

# Entorno
ENVIRONMENT=development
